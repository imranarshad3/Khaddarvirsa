# Public URL of the shop, used for canonical links, sitemap and JSON-LD. No trailing slash.
SITE_URL=http://localhost:3000

# Admin panel. SESSION_SECRET is required, plus Clerk sign-in (below) and/or ADMIN_PASSWORD.
# ADMIN_PASSWORD (optional fallback): choose a long password. SESSION_SECRET: at least 32 random characters,
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional. SQLite database file (created and seeded from data/reference on first start).
# DATABASE_PATH=./data/store.db

# Optional. Folder for images uploaded from the admin panel (served at /uploads/...).
# UPLOAD_DIR=./data/uploads

# Optional. Host serving the catalogue images that were imported from the current website.
# REFERENCE_IMAGE_BASE=https://kamaliakhaddar.pk/image/upload

# Admin sign-in with Clerk (same Clerk + Supabase projects as Rugistan). A Clerk user can open the
# admin only if their Supabase profiles.role is 'admin' (read-only lookup with the service-role key).
# Server-only except NEXT_PUBLIC_*. Never prefix the secret keys with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional extra origins allowed in Clerk tokens, comma separated (SITE_URL is always allowed).
# ADMIN_ALLOWED_ORIGINS=https://www.example.com

# Optional. Admin product photo assistant (Groq). Photos are sent to Groq only when an admin clicks "Draft from photo".
GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Backup AI for the admin assistant: used when Groq hits its limit (order Groq -> Gemini -> OpenRouter)
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free

# Copied from Rugistan but not used by this app yet:
# NEXT_PUBLIC_SUPABASE_URL=, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=, RATE_LIMIT_SECRET=, GEMINI_API_KEY=, OPENAI_API_KEY=

# New-order alerts (optional; each is skipped when unset). Email goes to Admin → Settings contact email, WhatsApp to the store WhatsApp number.
RESEND_API_KEY=
# ORDER_EMAIL_FROM="Khaddar Virsa <orders@khaddarvirsa.store>"   # only after verifying the domain in Resend
CALLMEBOT_APIKEY=
